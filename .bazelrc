# Bazel configuration for HunterClaw

# Use devtoolset-11 compilers (supports C++17)
build --action_env=CC=/opt/rh/devtoolset-11/root/usr/bin/gcc
build --action_env=CXX=/opt/rh/devtoolset-11/root/usr/bin/g++

# Disable warnings-as-errors for external dependencies like BoringSSL
build --host_copt=-Wno-error
build --copt=-Wno-error
