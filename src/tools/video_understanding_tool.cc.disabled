#include "hunterclaw/tools/video_understanding_tool.h"
#include <sstream>
#include <cstdio>
#include <array>
#include <fstream>
#include <vector>

namespace hunterclaw {
namespace tools {

VideoUnderstandingTool::VideoUnderstandingTool(
    std::shared_ptr<infra::HttpClient> http_client,
    std::shared_ptr<LLMClient> llm_client
) : http_client_(http_client),
    llm_client_(llm_client) {
    
    // Check if ffmpeg is installed (required for frame extraction)
    if (!is_ffmpeg_installed()) {
        // Log warning
        fprintf(stderr, "Warning: ffmpeg not found. Video frame extraction will not work.\n");
        fprintf(stderr, "Install ffmpeg: apt-get install ffmpeg (Linux) or brew install ffmpeg (macOS)\n");
    }
}

std::string VideoUnderstandingTool::description() const {
    return "Analyze and understand video content using AI vision models. "
           "Supports video description, action recognition, object tracking, and Q&A. "
           "Requires ffmpeg for frame extraction.";
}

core::JsonValue VideoUnderstandingTool::schema() const {
    core::JsonValue schema = core::JsonValue::object();
    schema["type"] = "object";
    
    core::JsonValue properties = core::JsonValue::object();
    
    // video_path
    core::JsonValue video_prop = core::JsonValue::object();
    video_prop["type"] = "string";
    video_prop["description"] = "Path to video file (MP4, MOV, AVI, etc.)";
    properties["video_path"] = video_prop;
    
    // prompt
    core::JsonValue prompt_prop = core::JsonValue::object();
    prompt_prop["type"] = "string";
    prompt_prop["description"] = "Question or instruction about the video";
    prompt_prop["default"] = "Describe what happens in this video.";
    properties["prompt"] = prompt_prop;
    
    // provider
    core::JsonValue provider_prop = core::JsonValue::object();
    provider_prop["type"] = "string";
    provider_prop["description"] = "AI provider to use";
    core::JsonValue provider_enum = core::JsonValue::array();
    provider_enum.push_back("openai");      // GPT-4o via frames
    provider_enum.push_back("anthropic");   // Claude via frames
    provider_enum.push_back("gemini");      // Native video (TODO)
    provider_prop["enum"] = provider_enum;
    provider_prop["default"] = "openai";
    properties["provider"] = provider_prop;
    
    // frame_count
    core::JsonValue frames_prop = core::JsonValue::object();
    frames_prop["type"] = "integer";
    frames_prop["description"] = "Number of frames to sample from video";
    frames_prop["default"] = 8;
    frames_prop["minimum"] = 1;
    frames_prop["maximum"] = 30;
    properties["frame_count"] = frames_prop;
    
    // model (optional)
    core::JsonValue model_prop = core::JsonValue::object();
    model_prop["type"] = "string";
    model_prop["description"] = "Specific model to use (optional)";
    properties["model"] = model_prop;
    
    schema["properties"] = properties;
    
    core::JsonValue required = core::JsonValue::array();
    required.push_back("video_path");
    schema["required"] = required;
    
    return schema;
}

core::JsonValue VideoUnderstandingTool::execute(const core::JsonValue& params) {
    // Validate video_path
    if (!params.has("video_path")) {
        core::JsonValue error = core::JsonValue::object();
        error["error"] = "Missing required parameter: video_path";
        return error;
    }
    
    std::string video_path = params["video_path"].as_string();
    std::string prompt = params.has("prompt") ? 
        params["prompt"].as_string() : "Describe what happens in this video.";
    std::string provider = params.has("provider") ? 
        params["provider"].as_string() : "openai";
    int frame_count = params.has("frame_count") ? 
        params["frame_count"].as_int() : 8;
    
    // Check if video file exists
    std::ifstream file(video_path);
    if (!file.good()) {
        core::JsonValue error = core::JsonValue::object();
        error["error"] = "Video file not found: " + video_path;
        return error;
    }
    file.close();
    
    // Check ffmpeg
    if (!is_ffmpeg_installed()) {
        core::JsonValue error = core::JsonValue::object();
        error["error"] = "ffmpeg not installed";
        error["hint"] = "Install ffmpeg to enable video analysis";
        return error;
    }
    
    // Get video info
    auto video_info = get_video_info(video_path);
    
    // Route to provider
    core::JsonValue result;
    if (provider == "openai") {
        result = analyze_with_openai(video_path, prompt, frame_count);
    } else if (provider == "anthropic" || provider == "claude") {
        result = analyze_with_claude(video_path, prompt, frame_count);
    } else if (provider == "gemini") {
        result = analyze_with_gemini(video_path, prompt);
    } else {
        core::JsonValue error = core::JsonValue::object();
        error["error"] = "Unknown provider: " + provider;
        return error;
    }
    
    // Add video info to result
    if (video_info.has("duration")) {
        result["video_duration"] = video_info["duration"];
    }
    if (video_info.has("resolution")) {
        result["video_resolution"] = video_info["resolution"];
    }
    if (video_info.has("fps")) {
        result["video_fps"] = video_info["fps"];
    }
    
    return result;
}

core::JsonValue VideoUnderstandingTool::analyze_with_openai(
    const std::string& video_path,
    const std::string& prompt,
    int frame_count
) {
    // Extract frames
    auto frames = extract_frames(video_path, frame_count);
    if (frames.empty()) {
        core::JsonValue error = core::JsonValue::object();
        error["error"] = "Failed to extract frames from video";
        return error;
    }
    
    // Build messages for OpenAI
    core::JsonValue messages = core::JsonValue::array();
    
    core::JsonValue user_msg = core::JsonValue::object();
    user_msg["role"] = "user";
    
    core::JsonValue content = core::JsonValue::array();
    
    // Add text prompt
    core::JsonValue text_part = core::JsonValue::object();
    text_part["type"] = "text";
    text_part["text"] = prompt + "\n\nThis video has been sampled into " + 
                        std::to_string(frame_count) + " frames shown in temporal order.";
    content.push_back(text_part);
    
    // Add frames
    for (const auto& frame_path : frames) {
        std::string frame_base64 = encode_frame_to_base64(frame_path);
        if (!frame_base64.empty()) {
            core::JsonValue image_part = core::JsonValue::object();
            image_part["type"] = "image_url";
            core::JsonValue image_url = core::JsonValue::object();
            image_url["url"] = "data:image/jpeg;base64," + frame_base64;
            image_part["image_url"] = image_url;
            content.push_back(image_part);
        }
    }
    
    user_msg["content"] = content;
    messages.push_back(user_msg);
    
    // Call OpenAI
    core::JsonValue request = core::JsonValue::object();
    request["model"] = "gpt-4o";
    request["messages"] = messages;
    request["max_tokens"] = 1000;
    
    auto response = llm_client_->chat_completion(request);
    
    // Extract result
    core::JsonValue result = core::JsonValue::object();
    result["status"] = "success";
    result["provider"] = "openai";
    result["model"] = "gpt-4o";
    result["frame_count"] = static_cast<int>(frames.size());
    
    if (response.has("choices") && response["choices"].is_array() && 
        response["choices"].size() > 0) {
        auto choice = response["choices"][0];
        if (choice.has("message") && choice["message"].has("content")) {
            result["analysis"] = choice["message"]["content"].as_string();
        }
    }
    
    if (response.has("usage")) {
        result["usage"] = response["usage"];
    }
    
    return result;
}

core::JsonValue VideoUnderstandingTool::analyze_with_claude(
    const std::string& video_path,
    const std::string& prompt,
    int frame_count
) {
    // Extract frames
    auto frames = extract_frames(video_path, frame_count);
    if (frames.empty()) {
        core::JsonValue error = core::JsonValue::object();
        error["error"] = "Failed to extract frames from video";
        return error;
    }
    
    // Build messages for Claude
    core::JsonValue messages = core::JsonValue::array();
    
    core::JsonValue user_msg = core::JsonValue::object();
    user_msg["role"] = "user";
    
    core::JsonValue content = core::JsonValue::array();
    
    // Add text prompt
    core::JsonValue text_part = core::JsonValue::object();
    text_part["type"] = "text";
    text_part["text"] = prompt + "\n\nThis video has been sampled into " + 
                        std::to_string(frame_count) + " frames shown in temporal order.";
    content.push_back(text_part);
    
    // Add frames
    for (const auto& frame_path : frames) {
        std::string frame_base64 = encode_frame_to_base64(frame_path);
        if (!frame_base64.empty()) {
            core::JsonValue image_part = core::JsonValue::object();
            image_part["type"] = "image";
            core::JsonValue source = core::JsonValue::object();
            source["type"] = "base64";
            source["media_type"] = "image/jpeg";
            source["data"] = frame_base64;
            image_part["source"] = source;
            content.push_back(image_part);
        }
    }
    
    user_msg["content"] = content;
    messages.push_back(user_msg);
    
    // Call Claude
    core::JsonValue request = core::JsonValue::object();
    request["model"] = "claude-3.5-sonnet";
    request["messages"] = messages;
    request["max_tokens"] = 1000;
    
    auto response = llm_client_->chat_completion(request);
    
    // Extract result
    core::JsonValue result = core::JsonValue::object();
    result["status"] = "success";
    result["provider"] = "anthropic";
    result["model"] = "claude-3.5-sonnet";
    result["frame_count"] = static_cast<int>(frames.size());
    
    if (response.has("content") && response["content"].is_array() && 
        response["content"].size() > 0) {
        auto content_item = response["content"][0];
        if (content_item.has("text")) {
            result["analysis"] = content_item["text"].as_string();
        }
    }
    
    if (response.has("usage")) {
        result["usage"] = response["usage"];
    }
    
    return result;
}

core::JsonValue VideoUnderstandingTool::analyze_with_gemini(
    const std::string& video_path,
    const std::string& prompt
) {
    // TODO: Implement Gemini native video understanding
    // Gemini supports direct video upload without frame extraction
    
    core::JsonValue error = core::JsonValue::object();
    error["error"] = "Gemini video understanding not yet implemented";
    error["hint"] = "Use 'openai' or 'anthropic' provider instead";
    return error;
}

std::vector<std::string> VideoUnderstandingTool::extract_frames(
    const std::string& video_path,
    int frame_count
) {
    std::vector<std::string> frame_paths;
    
    // Create temp directory for frames
    std::string temp_dir = "/tmp/video_frames_" + std::to_string(time(nullptr));
    std::string mkdir_cmd = "mkdir -p " + temp_dir;
    system(mkdir_cmd.c_str());
    
    // Use ffmpeg to extract frames evenly
    std::stringstream cmd;
    cmd << "ffmpeg -i \"" << video_path << "\" "
        << "-vf \"select='not(mod(n\\," << frame_count << "))'\" "
        << "-vsync vfr "
        << "-frames:v " << frame_count << " "
        << temp_dir << "/frame_%03d.jpg "
        << "2>&1";
    
    FILE* pipe = popen(cmd.str().c_str(), "r");
    if (pipe) {
        pclose(pipe);
    }
    
    // Collect extracted frames
    for (int i = 1; i <= frame_count; ++i) {
        std::stringstream frame_path;
        frame_path << temp_dir << "/frame_" 
                   << std::setfill('0') << std::setw(3) << i << ".jpg";
        
        std::ifstream file(frame_path.str());
        if (file.good()) {
            frame_paths.push_back(frame_path.str());
        }
        file.close();
    }
    
    return frame_paths;
}

std::string VideoUnderstandingTool::encode_frame_to_base64(
    const std::string& frame_path
) {
    // TODO: Implement proper base64 encoding
    // For now, return empty string
    // In production, use a base64 encoding library
    return "";
}

core::JsonValue VideoUnderstandingTool::get_video_info(const std::string& video_path) {
    core::JsonValue info = core::JsonValue::object();
    
    // Use ffprobe to get video metadata
    std::stringstream cmd;
    cmd << "ffprobe -v quiet -print_format json -show_streams \"" 
        << video_path << "\" 2>&1";
    
    FILE* pipe = popen(cmd.str().c_str(), "r");
    if (!pipe) {
        return info;
    }
    
    std::array<char, 128> buffer;
    std::string result;
    while (fgets(buffer.data(), buffer.size(), pipe) != nullptr) {
        result += buffer.data();
    }
    pclose(pipe);
    
    // Parse JSON result (simplified)
    // TODO: Proper JSON parsing
    
    return info;
}

bool VideoUnderstandingTool::is_ffmpeg_installed() {
    FILE* pipe = popen("ffmpeg -version 2>&1", "r");
    if (!pipe) {
        return false;
    }
    
    std::array<char, 128> buffer;
    std::string result;
    while (fgets(buffer.data(), buffer.size(), pipe) != nullptr) {
        result += buffer.data();
    }
    
    int return_code = pclose(pipe);
    return (return_code == 0 && result.find("ffmpeg") != std::string::npos);
}

std::string VideoUnderstandingTool::get_provider_description(
    const std::string& provider
) {
    if (provider == "openai") {
        return "OpenAI GPT-4o (frame sampling)";
    } else if (provider == "anthropic") {
        return "Anthropic Claude (frame sampling)";
    } else if (provider == "gemini") {
        return "Google Gemini (native video)";
    }
    return provider;
}

