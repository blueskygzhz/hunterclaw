{
  "dashboard": {
    "title": "HunterClaw Overview",
    "tags": ["hunterclaw", "overview"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(hunterclaw_http_requests_total[5m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "HTTP Request Duration (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(hunterclaw_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{endpoint}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "LLM Token Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(hunterclaw_llm_tokens_total{type=\"prompt\"}[5m])",
            "legendFormat": "Prompt - {{model}}"
          },
          {
            "expr": "rate(hunterclaw_llm_tokens_total{type=\"completion\"}[5m])",
            "legendFormat": "Completion - {{model}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Active Agents & Sessions",
        "type": "stat",
        "targets": [
          {
            "expr": "hunterclaw_agents_active",
            "legendFormat": "Agents"
          },
          {
            "expr": "hunterclaw_sessions_active",
            "legendFormat": "Sessions"
          }
        ]
      },
      {
        "id": 5,
        "title": "CPU Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "hunterclaw_process_cpu_percent"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 60, "color": "yellow"},
                {"value": 80, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Memory Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "hunterclaw_process_memory_bytes / 1024 / 1024"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "mbytes",
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 512, "color": "yellow"},
                {"value": 1024, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Tool Call Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(hunterclaw_tool_calls_total{status=\"success\"}[5m]) / rate(hunterclaw_tool_calls_total[5m]) * 100"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2
          }
        }
      },
      {
        "id": 8,
        "title": "Message Processing Duration (p50/p95/p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(hunterclaw_message_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(hunterclaw_message_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(hunterclaw_message_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ]
      }
    ]
  }
}
