# Simple Makefile for HunterClaw ReAct Example
# Usage: make -f Makefile.simple

CXX = g++
CXXFLAGS = -std=c++17 -O2 -Wall -Wextra
LDFLAGS =

# Enable devtoolset-11 for C++17 support
SHELL := /bin/bash
.SHELLFLAGS := -c 'source /opt/rh/devtoolset-11/enable 2>/dev/null || true; $$0 "$$@"'

# Directories
BINDIR = bin
EXAMPLEDIR = examples

# Targets
TARGET = $(BINDIR)/simple_react
SOURCE = $(EXAMPLEDIR)/simple_react.cc

.PHONY: all clean run help

all: $(TARGET)

$(BINDIR):
	@mkdir -p $(BINDIR)

$(TARGET): $(SOURCE) | $(BINDIR)
	@echo "编译 ReAct 示例程序..."
	@source /opt/rh/devtoolset-11/enable && \
		$(CXX) $(CXXFLAGS) -o $@ $< $(LDFLAGS)
	@echo "✓ 编译成功: $@"
	@ls -lh $@

run: $(TARGET)
	@echo "运行 ReAct 示例..."
	@echo "================================="
	@./$(TARGET)

clean:
	@echo "清理生成文件..."
	@rm -f $(TARGET)
	@echo "✓ 清理完成"

help:
	@echo "HunterClaw ReAct 简易编译系统"
	@echo ""
	@echo "使用方法:"
	@echo "  make -f Makefile.simple       # 编译"
	@echo "  make -f Makefile.simple run   # 编译并运行"
	@echo "  make -f Makefile.simple clean # 清理"
	@echo "  make -f Makefile.simple help  # 显示帮助"
	@echo ""
	@echo "目标文件: $(TARGET)"
	@echo "源文件: $(SOURCE)"
